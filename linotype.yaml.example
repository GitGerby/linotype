# Linotype Configuration Example
# Place this file as 'linotype.yaml' in your working directory,
# or in '~/.config/linotype/config.yaml', or point to it via --config.

api:
  base_url: "http://127.0.0.1:9931/v1"
  api_key: "YOUR_API_KEY"
  model: "gpt-4o"

ocr:
  language: "English"
  # Optional custom system prompt. If left empty, the built-in default prompt is used.
  # The {language} placeholder will be replaced with ocr.language.
  # prompt: |
  #   You are an OCR engine. The image contains subtitle text in {language}.
  #   Return ONLY the exact text visible in the image, preserving line breaks.

workers: 4
format: "ass"

# Debug options (writes a copy of every PNG sent to the LLM to png_export when debug is true)
# debug: false
# png_export: ""

